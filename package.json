{
  "name": "portfolio-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "setup": "node scripts/setup.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "size": "size-limit",
    "knip": "knip",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && node scripts/check-privacy.mjs",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@size-limit/file": "^14.2.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "knip": "^6.42.0",
    "prettier": "^3.9.10",
    "size-limit": "^14.2.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "size-limit": [
    {
      "name": "JS chunks",
      "path": ".next/static/chunks/**/*.js",
      "limit": "220 kB"
    },
    {
      "name": "CSS",
      "path": [
        ".next/static/css/**/*.css",
        ".next/static/chunks/**/*.css"
      ],
      "limit": "30 kB"
    }
  ]
}
